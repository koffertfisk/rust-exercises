audit.json
clippy.txt

# === Coverage / test / benchmarking ===
/coverage/
/grcov/
/tarpaulin-report.html

# === Git ===
.git/

# === Optional: ignore compiled binaries if you build them outside of /target
*.exe
*.dll
*.so
*.dylib
